# WebSocket RPC Endpoint for BSC
# For testing (free, no signup): wss://bsc.publicnode.com
# For production (get free API key): wss://bsc-mainnet.nodereal.io/ws/v1/YOUR_API_KEY
# See RPC_ENDPOINTS.md for more options
WS_RPC=wss://bsc.publicnode.com

# HTTP RPC for fallback and contract calls
HTTP_RPC=https://bsc-dataseed1.binance.org/

# Your bot wallet private key (KEEP THIS SECRET!)
PRIVATE_KEY=your_private_key_here

# Initial wallet to watch and copy trades from
START_WATCHED=0x0000000000000000000000000000000000000000

# PancakeSwap Router v2
PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E

# WBNB Token Address
WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# Trading Mode
COPY_BUY_ONLY=true
COPY_SELL=false
AUTO_TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PERCENT=100

# Trading Filters (adjust to your risk tolerance)
MAX_BUY_AMOUNT_BNB=0.5
SLIPPAGE_PERCENT=2
MAX_GAS_PRICE_GWEI=10
MIN_LIQUIDITY_USD=10000
MAX_TOKEN_AGE_HOURS=72

# One-time buy per token (prevents buying same token multiple times)
ONE_TIME_BUY_PER_TOKEN=true

# Auto-follow settings
AUTO_FOLLOW_ENABLED=true
MIN_TRANSFER_AMOUNT_BNB=0.1

# Blacklisted token addresses (comma-separated)
BLACKLISTED_TOKENS=

# Allowed router addresses (comma-separated, leave empty for all)
ALLOWED_ROUTERS=0x10ED43C718714eb63d5aA57B78B54704E256024E

# Speed Optimization
FAST_MODE=true
GAS_MULTIPLIER=1.2

# Logging
LOG_LEVEL=info

# Telegram Alerts (REQUIRED for watch alerts and notifications)
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_WATCH_ALERTS=false
SEND_TRADE_ALERTS=false
SEND_PROFIT_ALERTS=false

# MongoDB Database (for session persistence and history)
# Local: mongodb://localhost:27017/bnb-copy-bot
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/bnb-copy-bot
MONGODB_URI=mongodb://localhost:27017/bnb-copy-bot

# API Server Port
API_PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
